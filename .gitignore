# ===== Python =====
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# ===== 构建产物 =====
build/
dist/
*.egg-info/

# ===== Node =====
node_modules/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== 日志 / 临时 / 锁文件 =====
*.log
*.tmp
*.lock
*.auto
*.semaphore

# ===== 临时测试区（docs/FILE_LIFECYCLE.md，周检每周清理）=====
# 新项目临时脚本/试探参数只进这里，不入库；README.md 是说明文件，保留。
projects/*/TEMP/*
!projects/*/TEMP/README.md

# ===== ANSYS Maxwell 仿真缓存/结果目录 =====
*.aedtresults/

# ===== 派生生成物（由模板一键再生，不入库）=====
# 空载 maxwell_model/ 入库并受 --check 门禁；负载是同一模板 + 不同激励，
# 用 `gen_maxwell_model.py --case load` 再生即可，不重复存一份。
projects/25Nm_PMSM/maxwell_model_load/

# G7 斜槽多切片：`gen_maxwell_model.py --init-deg <deg> --out_dir maxwell_model_sXXX`
# 生成物（同一模板 + 一个角度），切片 CSV 已归档到 projects/results/fea/skew_slices/
projects/25Nm_PMSM/maxwell_model_s*/

# P12 匝数旋钮（cps 42 / 84 匝）：同一模板 + 一个 cps，同理不入库；
# CSV 已归档到 projects/results/fea/n84/ 与 n84_load/。
projects/25Nm_PMSM/maxwell_model_n84/
projects/25Nm_PMSM/maxwell_model_load_n84/

# E1 网格无关性：`gen_maxwell_model.py --mesh-scale <s> --out_dir maxwell_model_e1?`
# 只改 mesh.py 四个 MaxLength，其余生成物逐字相同 ⇒ 不入库；
# 12 个 401 行 CSV 已归档到 projects/results/fea/e1_{m,c,f}/。
projects/25Nm_PMSM/maxwell_model_e1*/

# E2 时间步无关性：`gen_maxwell_model.py --time-step-us <µs> --out_dir maxwell_model_e2t25`
# 只改 solver.py 的 TimeStep（StopTime 不变）⇒ 不入库；801 行 CSV 归档到
# projects/results/fea/e2_t25/。
projects/25Nm_PMSM/maxwell_model_e2*/

# ===== agent 运行时记忆（.workbuddy/）=====
# WorkBuddy agent 的会话记忆日志（每日 memory/*.md 与 automations/<uuid>/memory.md），
# 不是项目交付物；按 FILE_LIFECYCLE §2.2 归 TEMP（agent 生成、不入库）。
# 值得长期保留的工程决策已沉淀到 KEEP：projects/*/PROBLEM_LEDGER.md、
# docs/WEEKLY_AUDIT_*.md、docs/CLEANUP_REPORT_*.md，故日志本体不再重复入库。
.workbuddy/

# ===== 错误口径 / 已废弃的未跟踪 JSON（保留文件，但不入库）=====
# 按「不删文件」约束保留在磁盘，PROBLEM_LEDGER I37(11-28) 已判定，禁止引用：
#   m2_noload_spm_t065c8_bemf.json  RMS 135120 V（单位放大 1000x，verdict=FAIL），
#                                   已被 m2_noload_spm_t065c8.json（BEMF 135.1218 V PASS）取代
#   m4_start_soft.json              11-25 旧起动曲线（solved=False），已被
#                                   m4_start_summary_spm_t065c8_steady.json 取代
# 只排除这两个文件；同目录 102 个已跟踪 KEEP 证据 JSON 照常入库（禁止按目录整体排除）。
projects/results/ipm8p48s/m2_noload_spm_t065c8_bemf.json
projects/results/ipm8p48s/m4_start_soft.json

# ===== 敏感文件：ANSYS license / lmcksum 抓取输出 =====
# 根目录文件名 `100` 是 lmcksum 输出重定向残留，含 license 条目、ISSUER 与 SIGN2 签名，
# 属于凭证材料，禁止入库。
/100
